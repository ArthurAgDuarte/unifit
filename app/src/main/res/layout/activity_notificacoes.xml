<?xml version="1.0" encoding="utf-8"?>
<!-- Notificações: seta de voltar (no lugar do logo), sem menu inferior.
     A lista agora é um RecyclerView com cabeçalhos de data; a linha "N não lidas" fica fixa no topo. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/corFundo"
    tools:context=".ui.notificacoes.NotificacoesActivity">

    <!-- NOVO: botão voltar (mesmo estilo do Detalhe do Treino) -->
    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_circulo_cinza"
        android:backgroundTint="?attr/corSuperficie"
        android:contentDescription="@string/content_back"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="10dp"
        app:srcCompat="@drawable/ic_seta_voltar"
        app:tint="?attr/corTextoPrincipal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/txtTituloTela"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/notificacoes"
        android:textColor="?attr/corTextoPrincipal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnVoltar"
        app:layout_constraintBottom_toBottomOf="@id/btnVoltar"
        app:layout_constraintStart_toEndOf="@id/btnVoltar" />

    <!-- Sino (só decorativo nesta tela) -->
    <ImageView
        android:id="@+id/imgSino"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:padding="8dp"
        app:srcCompat="@drawable/ic_notificacao"
        app:tint="?attr/corTextoPrincipal"
        app:layout_constraintTop_toTopOf="@id/btnVoltar"
        app:layout_constraintBottom_toBottomOf="@id/btnVoltar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Linha abaixo do topo -->
    <View
        android:id="@+id/divisorTopo"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="?attr/corBorda"
        app:layout_constraintTop_toBottomOf="@id/btnVoltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contador de não lidas + marcar todas (fixo acima da lista) -->
    <LinearLayout
        android:id="@+id/layoutContador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/corFundoTela"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/divisorTopo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtNaoLidas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/corTextoSecundario"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="3 não lidas" />

        <TextView
            android:id="@+id/btnMarcarTodas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp"
            android:text="@string/marcar_todas_lidas"
            android:textColor="?attr/corDestaque"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- NOVO: lista (cabeçalhos de data + notificações) no lugar de layoutHoje / layoutOntem -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotificacoes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/corFundoTela"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/layoutContador"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_notificacao" />

    <!-- NOVO: carregando -->
    <ProgressBar
        android:id="@+id/progressNotificacoes"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="32dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/corDestaque"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutContador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- NOVO: lista vazia -->
    <TextView
        android:id="@+id/txtSemNotificacoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_card_tema"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/sem_notificacoes"
        android:textColor="?attr/corTextoSecundario"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutContador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
