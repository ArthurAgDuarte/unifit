            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="96dp">

            <!-- Campo de busca com filtro -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilBusca"
                style="@style/Widget.App.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="@color/white"
                app:endIconContentDescription="Filtrar"
                app:endIconDrawable="@drawable/ic_filtro"
                app:endIconMode="custom"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_busca">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBusca"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/field_height"
                    android:hint="Buscar por nome ou matrícula"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

