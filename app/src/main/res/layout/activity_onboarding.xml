<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/corFundo"
    tools:context=".ui.onboarding.OnboardingActivity">

    <!-- Logo pequeno do topo -->
    <ImageView
        android:id="@+id/imgLogoTopo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_logo_pequeno"
        android:backgroundTint="?attr/corDestaque"
        android:contentDescription="@string/logo_descricao"
        android:padding="6dp"
        app:srcCompat="@drawable/ic_haltere"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Nome do app -->
    <TextView
        android:id="@+id/txtNomeApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/app_name"
        android:textColor="?attr/corTextoPrincipal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/imgLogoTopo"
        app:layout_constraintBottom_toBottomOf="@id/imgLogoTopo"
        app:layout_constraintStart_toEndOf="@id/imgLogoTopo" />

    <!-- Botão Pular -->
    <TextView
        android:id="@+id/btnPular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp"
        android:text="@string/onboarding_pular"
        android:textColor="?attr/corTextoSecundario"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/imgLogoTopo"
        app:layout_constraintBottom_toBottomOf="@id/imgLogoTopo"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- NOVO: slides (card da ilustração, título e descrição ficam em item_onboarding.xml) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerOnboarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/imgLogoTopo"
        app:layout_constraintBottom_toTopOf="@id/layoutIndicadores"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_onboarding" />

    <!-- Indicadores de página (bolinhas): agora fixos acima do botão, fora dos slides -->
    <LinearLayout
        android:id="@+id/layoutIndicadores"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btnComecar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/indicador1"
            android:layout_width="24dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_indicador_ativo" />

        <View
            android:id="@+id/indicador2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_indicador_inativo" />

        <View
            android:id="@+id/indicador3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_indicador_inativo" />

    </LinearLayout>

    <!-- Botão principal -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnComecar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="?attr/corDestaque"
        android:text="@string/onboarding_proximo"
        android:textAllCaps="false"
        android:textColor="?attr/corTextoSobreDestaque"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
