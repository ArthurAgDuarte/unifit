<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    app:circularflow_defaultRadius="16dp"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            app:srcCompat="@drawable/img_logo_login" />

        <ImageView
            android:id="@+id/logo2"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            android:background="#3F51B5"
            android:scrollbarSize="100sp"
            android:tint="#FFFFFF"
            app:srcCompat="@drawable/baseline_fitness_center_24" />

        <TextView
            android:id="@+id/bemVindo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="20dp"
            android:text="Bem-vindo de volta!"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/indro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="6dp"
            android:text="Entre com sua conta institucional para acessar seus treinos e aulas."
            android:textSize="15sp" />

        <TextView
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="20dp"
            android:text="E-mail ou matrícula"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/emailSenha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/bg_edittext"
            android:drawableStart="@drawable/ic_email_custom"
            android:drawablePadding="12dp"
            android:ems="10"
            android:hint="nome@universidade.edu.br"
            android:inputType="text|textEmailAddress"
            android:paddingEnd="16dp"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/senha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            android:text="Senha"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/senhaSenha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/bg_edittext"
            android:drawableStart="@drawable/ic_lock_custom"
            android:drawableEnd="@drawable/ic_eye_custom"
            android:drawablePadding="12dp"
            android:ems="10"
            android:hint="••••••••"
            android:inputType="text|textPassword"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/esqueciSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginRight="10dp"
            android:gravity="right"
            android:text="Esqueci minha senha"
            android:textColor="#3F51B5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/entrar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/bg_button_entrar"
            android:backgroundTint="#CDDC39"
            android:text="Entrar"
            android:textColorLink="#2196F3" />

        <TextView
            android:id="@+id/linhaOu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="---------------------------------------------------- ou -------------------------------------------------"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/criarConta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/bg_button_criar"
            android:gravity="center"
            android:text="Criar conta"
            android:textColor="#3F51B5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Acessível em Libras com VLibras"
            android:textSize="13sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
