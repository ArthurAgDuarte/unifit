<?xml version="1.0" encoding="utf-8"?>
<!-- Cabeçalho de data na lista de notificações (HOJE, ONTEM, 15/09).
     Mesmo estilo dos antigos txtSecaoHoje / txtSecaoOntem. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/txtCabecalhoData"
