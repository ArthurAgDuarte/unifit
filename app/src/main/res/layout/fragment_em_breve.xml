<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder das abas que ainda não fazem parte do escopo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/corFundoTela"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_circulo_azul_claro"
        android:backgroundTint="?attr/corDestaqueClaro"
        android:importantForAccessibility="no"
        android:padding="20dp"
        app:srcCompat="@drawable/ic_relogio"
        app:tint="?attr/corDestaque" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/em_breve"
        android:textColor="?attr/corTextoPrincipal"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/em_breve_descricao"
        android:textColor="?attr/corTextoSecundario"
        android:textSize="14sp" />

</LinearLayout>
