<?xml version="1.0" encoding="utf-8"?>
<!-- Card de um indicador de saúde (Peso, Calorias, Hidratação) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_card_branco"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgIndicador"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circulo_verde_claro"
            android:contentDescription="Ícone do indicador"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_peso"
            app:tint="@color/verde_hoje_texto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomeIndicador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Peso"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtValorIndicador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="64,2"
                    android:textColor="@color/texto_principal"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtUnidadeIndicador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="kg"
                    android:textColor="@color/texto_secundario"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Botão + (registrar novo valor, RF17.2) -->
        <ImageView
            android:id="@+id/btnAdicionarIndicador"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circulo_azul"
            android:contentDescription="Registrar novo valor"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="13dp"
            app:srcCompat="@drawable/ic_mais"
            app:tint="@color/white" />

    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressoIndicador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:progress="72"
        app:indicatorColor="@color/verde_hoje_texto"
        app:trackColor="@color/cinza_botao"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtMetaIndicador"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Meta: 62 kg"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txtPercentualIndicador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="72%"
            android:textColor="@color/verde_hoje_texto"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
