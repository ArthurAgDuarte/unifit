<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/txtNumeroPasso"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_numero_passo"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/azul_unifit"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtPassoText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_branco"
        android:hint="Descreva o passo da execução..."
        android:inputType="textCapSentences|textMultiLine"
        android:padding="12dp"
        android:textColor="@color/texto_principal"
        android:textColorHint="@color/text_hint"
        android:textSize="14sp" />

</LinearLayout>