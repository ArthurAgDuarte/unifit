<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".AulasActivity">

    <!-- Logo pequeno do topo -->
    <ImageView
        android:id="@+id/imgLogoTopo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_logo_pequeno"
        android:contentDescription="Logo UniFit"
        android:padding="6dp"
        app:srcCompat="@drawable/ic_haltere"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/txtTituloTela"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="Aulas Coletivas"
        android:textColor="@color/texto_principal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/imgLogoTopo"
        app:layout_constraintBottom_toBottomOf="@id/imgLogoTopo"
        app:layout_constraintStart_toEndOf="@id/imgLogoTopo" />

    <!-- Sino: abre Notificações -->
    <ImageView
        android:id="@+id/btnNotificacoes"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Notificações"
        android:padding="8dp"
        app:srcCompat="@drawable/ic_notificacao"
        app:tint="@color/texto_principal"
        app:layout_constraintTop_toTopOf="@id/imgLogoTopo"
        app:layout_constraintBottom_toBottomOf="@id/imgLogoTopo"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Linha abaixo do topo -->
    <View
        android:id="@+id/divisorTopo"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/borda_card"
        app:layout_constraintTop_toBottomOf="@id/imgLogoTopo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Conteúdo com rolagem -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollConteudo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/fundo_tela"
        app:layout_constraintTop_toBottomOf="@id/divisorTopo"
        app:layout_constraintBottom_toBottomOf="@id/divisorMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Chips de filtro (preenchidos no código) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutCategorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <!-- Mock: aparece no preview; no app o código troca pelos dados reais -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_selecionado"
                        android:paddingStart="18dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="9dp"
                        android:text="Todas"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_normal"
                        android:paddingStart="18dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="9dp"
                        android:text="Spinning"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_normal"
                        android:paddingStart="18dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="9dp"
                        android:text="Yoga"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_normal"
                        android:paddingStart="18dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="9dp"
                        android:text="Funcional"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_normal"
                        android:paddingStart="18dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="9dp"
                        android:text="Pilates"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_normal"
                        android:paddingStart="18dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="9dp"
                        android:text="Zumba"
                        android:textColor="@color/texto_principal"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                </LinearLayout>

            </HorizontalScrollView>

            <!-- Aulas agrupadas por dia (preenchidas no código) -->
            <LinearLayout
                android:id="@+id/layoutAulas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- Mock: aparece no preview; no app o código troca pelos dados reais -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hoje, 16 de setembro"
                        android:textColor="@color/texto_secundario"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="Ver semana"
                        android:textColor="@color/azul_unifit"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>

                     (usado em Aulas, Histórico, Gerenciar Usuários, Gerenciar Aulas e Exercícios e Aparelhos) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_branco"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_icone_notificacao"
                        android:clipToOutline="true"
                        android:contentDescription="Ícone"
                        android:padding="16dp"
                        app:srcCompat="@drawable/ic_atividade"
                        app:tint="@color/azul_unifit" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Spinning"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="18:30 • Prof. Carlos • 4 vagas • Reservada"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- Etiqueta (Ativo / Inativo) — escondida por padrão -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_status_ativo"
                        android:paddingStart="16dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="6dp"
                        android:text="Ativo"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Abrir"
                        app:srcCompat="@drawable/ic_seta_direita"
                        app:tint="@color/texto_secundario" />

                </LinearLayout>

                     (usado em Aulas, Histórico, Gerenciar Usuários, Gerenciar Aulas e Exercícios e Aparelhos) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_branco"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_icone_notificacao"
                        android:clipToOutline="true"
                        android:contentDescription="Ícone"
                        android:padding="16dp"
                        app:srcCompat="@drawable/ic_brilho"
                        app:tint="@color/azul_unifit" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Yoga"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="19:00 • Prof.ª Marina • 12 vagas"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- Etiqueta (Ativo / Inativo) — escondida por padrão -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_status_ativo"
                        android:paddingStart="16dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="6dp"
                        android:text="Ativo"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Abrir"
                        app:srcCompat="@drawable/ic_seta_direita"
                        app:tint="@color/texto_secundario" />

                </LinearLayout>

                     (usado em Aulas, Histórico, Gerenciar Usuários, Gerenciar Aulas e Exercícios e Aparelhos) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_branco"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_icone_vermelho"
                        android:clipToOutline="true"
                        android:contentDescription="Ícone"
                        android:padding="16dp"
                        app:srcCompat="@drawable/ic_haltere"
                        app:tint="@color/vermelho_status" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Funcional"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="20:00 • Prof. Rafael • Lotada"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- Etiqueta (Ativo / Inativo) — escondida por padrão -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_status_ativo"
                        android:paddingStart="16dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="6dp"
                        android:text="Ativo"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Abrir"
                        app:srcCompat="@drawable/ic_seta_direita"
                        app:tint="@color/texto_secundario" />

                </LinearLayout>

                     (usado em Aulas, Histórico, Gerenciar Usuários, Gerenciar Aulas e Exercícios e Aparelhos) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_branco"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_icone_notificacao"
                        android:clipToOutline="true"
                        android:contentDescription="Ícone"
                        android:padding="16dp"
                        app:srcCompat="@drawable/ic_pessoa_em_pe"
                        app:tint="@color/azul_unifit" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Pilates"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="20:30 • Prof.ª Júlia • 8 vagas"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- Etiqueta (Ativo / Inativo) — escondida por padrão -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_status_ativo"
                        android:paddingStart="16dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="6dp"
                        android:text="Ativo"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Abrir"
                        app:srcCompat="@drawable/ic_seta_direita"
                        app:tint="@color/texto_secundario" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Amanhã"
                        android:textColor="@color/texto_principal"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="Ver semana"
                        android:textColor="@color/azul_unifit"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                     (usado em Aulas, Histórico, Gerenciar Usuários, Gerenciar Aulas e Exercícios e Aparelhos) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_branco"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_icone_notificacao"
                        android:clipToOutline="true"
                        android:contentDescription="Ícone"
                        android:padding="16dp"
                        app:srcCompat="@drawable/ic_atividade"
                        app:tint="@color/azul_unifit" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Zumba"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="07:30 • Prof.ª Lia • 15 vagas"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- Etiqueta (Ativo / Inativo) — escondida por padrão -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_status_ativo"
                        android:paddingStart="16dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="6dp"
                        android:text="Ativo"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Abrir"
                        app:srcCompat="@drawable/ic_seta_direita"
                        app:tint="@color/texto_secundario" />

                </LinearLayout>

            </LinearLayout>

            <!-- Aparece quando a lista está vazia -->
            <TextView
                android:id="@+id/txtSemAulas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_branco"
                android:gravity="center"
                android:padding="20dp"
                android:text="Nenhuma aula desta categoria."
                android:textColor="@color/texto_secundario"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Linha acima do menu -->
    <View
        android:id="@+id/divisorMenu"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/borda_card"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Menu inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemActiveIndicatorStyle="@style/IndicadorTransparente"
        app:itemIconTint="@color/cor_item_bottom_nav"
        app:itemTextAppearanceActive="@style/TextoBottomNav"
        app:itemTextAppearanceInactive="@style/TextoBottomNav"
        app:itemTextColor="@color/cor_item_bottom_nav"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
