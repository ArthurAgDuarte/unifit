<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".IndicadoresSaudeActivity">

    <!-- Logo pequeno do topo -->
    <ImageView
        android:id="@+id/imgLogoTopo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_logo_pequeno"
        android:contentDescription="Logo UniFit"
        android:padding="6dp"
        app:srcCompat="@drawable/ic_haltere"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/txtTituloTela"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="Indicadores de Saúde"
        android:textColor="@color/texto_principal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/imgLogoTopo"
        app:layout_constraintBottom_toBottomOf="@id/imgLogoTopo"
        app:layout_constraintStart_toEndOf="@id/imgLogoTopo" />

    <!-- Sino: abre Notificações -->
    <ImageView
        android:id="@+id/btnNotificacoes"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Notificações"
        android:padding="8dp"
        app:srcCompat="@drawable/ic_notificacao"
        app:tint="@color/texto_principal"
        app:layout_constraintTop_toTopOf="@id/imgLogoTopo"
        app:layout_constraintBottom_toBottomOf="@id/imgLogoTopo"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Linha abaixo do topo -->
    <View
        android:id="@+id/divisorTopo"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/borda_card"
        app:layout_constraintTop_toBottomOf="@id/imgLogoTopo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Conteúdo com rolagem -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollConteudo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/fundo_tela"
        app:layout_constraintTop_toBottomOf="@id/divisorTopo"
        app:layout_constraintBottom_toBottomOf="@id/divisorMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/txtDataHoje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Hoje, 16 de setembro"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />

            <!-- Cards de Peso, Calorias e Hidratação (preenchido no código) -->
            <LinearLayout
                android:id="@+id/layoutIndicadores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Mock: aparece no preview; no app o código troca pelos dados reais -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_branco"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circulo_verde_claro"
                            android:contentDescription="Ícone do indicador"
                            android:padding="12dp"
                            app:srcCompat="@drawable/ic_peso"
                            app:tint="@color/verde_hoje_texto" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Peso"
                                android:textColor="@color/texto_secundario"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:baselineAligned="true"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="64,2"
                                    android:textColor="@color/texto_principal"
                                    android:textSize="30sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="kg"
                                    android:textColor="@color/texto_secundario"
                                    android:textSize="16sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Botão + (registrar novo valor, RF17.2) -->
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circulo_azul"
                            android:contentDescription="Registrar novo valor"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:padding="13dp"
                            app:srcCompat="@drawable/ic_mais"
                            app:tint="@color/white" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:progress="72"
                        app:indicatorColor="@color/verde_hoje_texto"
                        app:trackColor="@color/cinza_botao"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Meta: 62 kg"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="72%"
                            android:textColor="@color/verde_hoje_texto"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_branco"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circulo_amarelo_claro"
                            android:contentDescription="Ícone do indicador"
                            android:padding="12dp"
                            app:srcCompat="@drawable/ic_chama"
                            app:tint="@color/amarelo" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Calorias"
                                android:textColor="@color/texto_secundario"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:baselineAligned="true"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1.840"
                                    android:textColor="@color/texto_principal"
                                    android:textSize="30sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="kcal"
                                    android:textColor="@color/texto_secundario"
                                    android:textSize="16sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Botão + (registrar novo valor, RF17.2) -->
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circulo_azul"
                            android:contentDescription="Registrar novo valor"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:padding="13dp"
                            app:srcCompat="@drawable/ic_mais"
                            app:tint="@color/white" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:progress="84"
                        app:indicatorColor="@color/amarelo"
                        app:trackColor="@color/cinza_botao"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Meta: 2.200 kcal"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="84%"
                            android:textColor="@color/amarelo"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_branco"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circulo_azul_claro"
                            android:contentDescription="Ícone do indicador"
                            android:padding="12dp"
                            app:srcCompat="@drawable/ic_gota"
                            app:tint="@color/azul_unifit" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hidratação"
                                android:textColor="@color/texto_secundario"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:baselineAligned="true"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1,6"
                                    android:textColor="@color/texto_principal"
                                    android:textSize="30sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="L"
                                    android:textColor="@color/texto_secundario"
                                    android:textSize="16sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Botão + (registrar novo valor, RF17.2) -->
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_circulo_azul"
                            android:contentDescription="Registrar novo valor"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:padding="13dp"
                            app:srcCompat="@drawable/ic_mais"
                            app:tint="@color/white" />

                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:progress="64"
                        app:indicatorColor="@color/azul_unifit"
                        app:trackColor="@color/cinza_botao"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Meta: 2,5 L"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="64%"
                            android:textColor="@color/azul_unifit"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Dica contextual (RF17.3) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dica"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="Dica"
                    app:srcCompat="@drawable/ic_info"
                    app:tint="@color/azul_unifit" />

                <TextView
                    android:id="@+id/txtDicaSaude"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="Beba água a cada 2 horas para bater sua meta de hidratação."
                    android:textColor="@color/azul_unifit"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Linha acima do menu -->
    <View
        android:id="@+id/divisorMenu"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/borda_card"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Menu inferior -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:itemActiveIndicatorStyle="@style/IndicadorTransparente"
        app:itemIconTint="@color/cor_item_bottom_nav"
        app:itemTextAppearanceActive="@style/TextoBottomNav"
        app:itemTextAppearanceInactive="@style/TextoBottomNav"
        app:itemTextColor="@color/cor_item_bottom_nav"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
