<?xml version="1.0" encoding="utf-8"?>
<!-- Card de uma ficha na lista "Fichas Ativas".
     A etiqueta "Hoje" fica na mesma linha do nome, que encolhe (weight=1 + ellipsize):
     assim ela nunca passa por cima da seta, que está fora dessa linha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_tema"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Foto do treino -->
    <ImageView
        android:id="@+id/imgFicha"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_miniatura"
        android:clipToOutline="true"
        android:contentDescription="@string/foto_treino"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/foto_treino_a" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtNomeFicha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/corTextoPrincipal"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Treino A — Peito e Tríceps" />

            <!-- Etiqueta "Hoje" -->
            <TextView
                android:id="@+id/txtHoje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_hoje"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/hoje"
                android:textColor="?attr/corSucessoTexto"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtInfoFicha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/corTextoSecundario"
            android:textSize="14sp"
            tools:text="8 exercícios • ~45 min" />

    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/abrir_treino"
        app:srcCompat="@drawable/ic_seta_direita"
        app:tint="?attr/corTextoSecundario" />

</LinearLayout>
