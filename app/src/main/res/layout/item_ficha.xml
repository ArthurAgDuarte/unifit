<?xml version="1.0" encoding="utf-8"?>
<!-- Card de uma ficha na lista "Fichas Ativas" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_branco"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Foto do treino -->
    <ImageView
        android:id="@+id/imgFicha"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_miniatura"
        android:clipToOutline="true"
        android:contentDescription="Foto do treino"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/foto_treino_a" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtNomeFicha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Treino A — Peito e Tríceps"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Etiqueta "Hoje" -->
            <TextView
                android:id="@+id/txtHoje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_hoje"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Hoje"
                android:textColor="@color/verde_hoje_texto"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtInfoFicha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="8 exercícios • ~45 min"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Abrir treino"
        app:srcCompat="@drawable/ic_seta_direita"
        app:tint="@color/texto_secundario" />

</LinearLayout>
