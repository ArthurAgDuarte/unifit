<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".DetalheTreinoActivity">

    <!-- Botão voltar -->
    <ImageView
        android:id="@+id/btnVoltar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_circulo_cinza"
        android:contentDescription="Voltar"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="10dp"
        app:srcCompat="@drawable/ic_seta_voltar"
        app:tint="@color/texto_principal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/txtTituloTela"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Detalhe do Treino"
        android:textColor="@color/texto_principal"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btnVoltar"
        app:layout_constraintBottom_toBottomOf="@id/btnVoltar"
        app:layout_constraintStart_toEndOf="@id/btnVoltar" />

    <!-- Botão de mais opções -->
    <ImageView
        android:id="@+id/btnMaisOpcoes"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Mais opções"
        android:padding="10dp"
        app:srcCompat="@drawable/ic_mais_opcoes"
        app:tint="@color/texto_principal"
        app:layout_constraintTop_toTopOf="@id/btnVoltar"
        app:layout_constraintBottom_toBottomOf="@id/btnVoltar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Linha abaixo do topo -->
    <View
        android:id="@+id/divisorTopo"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/borda_card"
        app:layout_constraintTop_toBottomOf="@id/btnVoltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Conteúdo com rolagem -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollConteudo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/fundo_tela"
        app:layout_constraintTop_toBottomOf="@id/divisorTopo"
        app:layout_constraintBottom_toTopOf="@id/divisorRodape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp">

            <!-- Card com o resumo do treino -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_branco"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/txtNomeTreino"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Treino A — Peito e Tríceps"
                    android:textColor="@color/texto_principal"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Etiquetas: exercícios, duração e nível -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="6dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="Exercícios"
                                app:srcCompat="@drawable/ic_haltere"
                                app:tint="@color/texto_secundario" />

                            <TextView
                                android:id="@+id/txtQtdExercicios"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="8 exercícios"
                                android:textColor="@color/texto_secundario"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="6dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="Duração"
                                app:srcCompat="@drawable/ic_relogio"
                                app:tint="@color/texto_secundario" />

                            <TextView
                                android:id="@+id/txtDuracao"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="~45 min"
                                android:textColor="@color/texto_secundario"
                                android:textSize="13sp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="6dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="Nível"
                                app:srcCompat="@drawable/ic_atividade"
                                app:tint="@color/texto_secundario" />

                            <TextView
                                android:id="@+id/txtNivel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Intermediário"
                                android:textColor="@color/texto_secundario"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

            <!-- Cabeçalho da lista de exercícios -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Exercícios"
                    android:textColor="@color/texto_principal"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtQtdItens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8 itens"
                    android:textColor="@color/azul_unifit"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Lista de exercícios -->
            <LinearLayout
                android:id="@+id/layoutExercicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Mock: aparece no preview; no app o código troca pelos dados reais -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- Foto do exercício -->
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_miniatura"
                        android:clipToOutline="true"
                        android:contentDescription="Foto do exercício"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/foto_exercicio" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Supino reto com barra"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="4 × 10 • 60 kg"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Botão de play (vídeo do exercício) -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_circulo_azul_claro"
                        android:contentDescription="Ver vídeo do exercício"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_play" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- Foto do exercício -->
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_miniatura"
                        android:clipToOutline="true"
                        android:contentDescription="Foto do exercício"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/foto_exercicio" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Supino inclinado c/ halteres"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="3 × 12 • 22 kg"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Botão de play (vídeo do exercício) -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_circulo_azul_claro"
                        android:contentDescription="Ver vídeo do exercício"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_play" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- Foto do exercício -->
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_miniatura"
                        android:clipToOutline="true"
                        android:contentDescription="Foto do exercício"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/foto_exercicio" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Crucifixo na máquina"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="3 × 12 • 35 kg"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Botão de play (vídeo do exercício) -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_circulo_azul_claro"
                        android:contentDescription="Ver vídeo do exercício"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_play" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- Foto do exercício -->
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_miniatura"
                        android:clipToOutline="true"
                        android:contentDescription="Foto do exercício"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/foto_exercicio" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Tríceps na polia"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="4 × 12 • 25 kg"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Botão de play (vídeo do exercício) -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_circulo_azul_claro"
                        android:contentDescription="Ver vídeo do exercício"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_play" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- Foto do exercício -->
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_miniatura"
                        android:clipToOutline="true"
                        android:contentDescription="Foto do exercício"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/foto_exercicio" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Tríceps francês"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="3 × 10 • 14 kg"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Botão de play (vídeo do exercício) -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_circulo_azul_claro"
                        android:contentDescription="Ver vídeo do exercício"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_play" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- Foto do exercício -->
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_miniatura"
                        android:clipToOutline="true"
                        android:contentDescription="Foto do exercício"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/foto_exercicio" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Crossover"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="3 × 15 • 15 kg"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Botão de play (vídeo do exercício) -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_circulo_azul_claro"
                        android:contentDescription="Ver vídeo do exercício"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_play" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- Foto do exercício -->
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_miniatura"
                        android:clipToOutline="true"
                        android:contentDescription="Foto do exercício"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/foto_exercicio" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Paralelas"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="3 × 10 • Peso corporal"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Botão de play (vídeo do exercício) -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_circulo_azul_claro"
                        android:contentDescription="Ver vídeo do exercício"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_play" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card_branco"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- Foto do exercício -->
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_miniatura"
                        android:clipToOutline="true"
                        android:contentDescription="Foto do exercício"
                        android:scaleType="centerCrop"
                        app:srcCompat="@drawable/foto_exercicio" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Tríceps coice"
                            android:textColor="@color/texto_principal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="3 × 12 • 8 kg"
                            android:textColor="@color/texto_secundario"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Botão de play (vídeo do exercício) -->
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_circulo_azul_claro"
                        android:contentDescription="Ver vídeo do exercício"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        app:srcCompat="@drawable/ic_play" />

                </LinearLayout>

            </LinearLayout>

            <!-- Aparece quando a ficha não tem exercícios -->
            <TextView
                android:id="@+id/txtSemExercicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_branco"
                android:gravity="center"
                android:padding="20dp"
                android:text="Nenhum exercício ainda. Toque em ⋮ e depois em Adicionar exercício."
                android:textColor="@color/texto_secundario"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Linha acima do botão -->
    <View
        android:id="@+id/divisorRodape"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/borda_card"
        app:layout_constraintBottom_toTopOf="@id/btnIniciarTreino"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botão principal -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIniciarTreino"
        android:layout_width="0dp"
        android:layout_height="56dp"
