<?xml version="1.0" encoding="utf-8"?>
<!-- Card de lista: ícone ou foto + título + subtítulo + etiqueta opcional + seta
     (usado em Aulas, Histórico, Gerenciar Usuários, Gerenciar Aulas e Exercícios e Aparelhos) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_branco"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imgItem"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_icone_notificacao"
        android:clipToOutline="true"
        android:contentDescription="Ícone"
        android:padding="16dp"
        app:srcCompat="@drawable/ic_atividade"
        app:tint="@color/azul_unifit" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTituloItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Spinning"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtituloItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="18:30 • Prof. Carlos • 4 vagas"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Etiqueta (Ativo / Inativo) — escondida por padrão -->
    <TextView
        android:id="@+id/txtStatusItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_status_ativo"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="Ativo"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imgSetaItem"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Abrir"
        app:srcCompat="@drawable/ic_seta_direita"
        app:tint="@color/texto_secundario" />

</LinearLayout>
