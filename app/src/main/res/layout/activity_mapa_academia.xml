<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".MapaAcademiaActivity">

    <!-- Top Header Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_screen"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivAppLogo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/ic_logo_mapa"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/header_app_title"
            android:textColor="@color/text_primary_mapa"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/ivAppLogo"
            app:layout_constraintStart_toEndOf="@id/ivAppLogo"
            app:layout_constraintTop_toTopOf="@id/ivAppLogo" />

        <ImageButton
            android:id="@+id/btnNotification"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_notification"
            android:src="@drawable/ic_notification_mapa"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Main Content -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Search Field with TextInputLayout -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearch"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/hint_search_email"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:endIconDrawable="@drawable/ic_filter"
                app:endIconMode="custom"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:importantForAutofill="yes"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearchSubmit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/blue_primary"
                android:text="@string/btn_search"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tilSearch" />

            <!-- Interactive Gym Map Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnSearchSubmit"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/map_section_title"
                        android:textColor="@color/text_primary_mapa"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/map_section_subtitle"
                        android:textColor="@color/text_secondary_mapa"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSelectedLocationOnMap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_blue_icon_sq"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:text="@string/map_default_selected"
                        android:textColor="@color/blue_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imgMap"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="12dp"
                        android:contentDescription="@string/cd_gym_map"
                        android:scaleType="fitCenter"
                        android:src="@drawable/img_gym_map_full" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Legend Header Row -->
            <TextView
                android:id="@+id/tvLegendTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_legend"
                android:textColor="@color/text_primary_mapa"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardMap" />

            <TextView
                android:id="@+id/tvLocationsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/value_locations_count"
                android:textColor="@color/blue_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvLegendTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvLegendTitle" />

            <!-- Location Card 1: Musculação -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLoc1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvLegendTitle"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <View
                        android:id="@+id/bgIcon1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_blue_icon_sq"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_pin_location_blue"
                        app:layout_constraintBottom_toBottomOf="@id/bgIcon1"
                        app:layout_constraintEnd_toEndOf="@id/bgIcon1"
                        app:layout_constraintStart_toStartOf="@id/bgIcon1"
                        app:layout_constraintTop_toTopOf="@id/bgIcon1" />

                    <TextView
                        android:id="@+id/tvLoc1Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/loc_1_title"
                        android:textColor="@color/text_primary_mapa"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/icChevron1"
                        app:layout_constraintStart_toEndOf="@id/bgIcon1"
                        app:layout_constraintTop_toTopOf="@id/bgIcon1" />

                    <TextView
                        android:id="@+id/tvLoc1Sub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/loc_1_sub"
                        android:textColor="@color/text_secondary_mapa"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/icChevron1"
                        app:layout_constraintStart_toEndOf="@id/bgIcon1"
                        app:layout_constraintTop_toBottomOf="@id/tvLoc1Title" />

                    <ImageView
                        android:id="@+id/icChevron1"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location Card 2: Cardio -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLoc2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardLoc1"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <View
                        android:id="@+id/bgIcon2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_blue_icon_sq"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_pin_location_blue"
                        app:layout_constraintBottom_toBottomOf="@id/bgIcon2"
                        app:layout_constraintEnd_toEndOf="@id/bgIcon2"
                        app:layout_constraintStart_toStartOf="@id/bgIcon2"
                        app:layout_constraintTop_toTopOf="@id/bgIcon2" />

                    <TextView
                        android:id="@+id/tvLoc2Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/loc_2_title"
                        android:textColor="@color/text_primary_mapa"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/icChevron2"
                        app:layout_constraintStart_toEndOf="@id/bgIcon2"
                        app:layout_constraintTop_toTopOf="@id/bgIcon2" />

                    <TextView
                        android:id="@+id/tvLoc2Sub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/loc_2_sub"
                        android:textColor="@color/text_secondary_mapa"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/icChevron2"
                        app:layout_constraintStart_toEndOf="@id/bgIcon2"
                        app:layout_constraintTop_toBottomOf="@id/tvLoc2Title" />

                    <ImageView
                        android:id="@+id/icChevron2"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location Card 3: Spinning -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLoc3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardLoc2"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <View
                        android:id="@+id/bgIcon3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_blue_icon_sq"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_pin_location_blue"
                        app:layout_constraintBottom_toBottomOf="@id/bgIcon3"
                        app:layout_constraintEnd_toEndOf="@id/bgIcon3"
                        app:layout_constraintStart_toStartOf="@id/bgIcon3"
                        app:layout_constraintTop_toTopOf="@id/bgIcon3" />

                    <TextView
                        android:id="@+id/tvLoc3Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/loc_3_title"
                        android:textColor="@color/text_primary_mapa"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/icChevron3"
                        app:layout_constraintStart_toEndOf="@id/bgIcon3"
                        app:layout_constraintTop_toTopOf="@id/bgIcon3" />

                    <TextView
                        android:id="@+id/tvLoc3Sub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/loc_3_sub"
                        android:textColor="@color/text_secondary_mapa"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/icChevron3"
                        app:layout_constraintStart_toEndOf="@id/bgIcon3"
                        app:layout_constraintTop_toBottomOf="@id/tvLoc3Title" />

                    <ImageView
                        android:id="@+id/icChevron3"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location Card 4: Área Funcional -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLoc4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardLoc3"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <View
                        android:id="@+id/bgIcon4"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_blue_icon_sq"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_pin_location_blue"
                        app:layout_constraintBottom_toBottomOf="@id/bgIcon4"
                        app:layout_constraintEnd_toEndOf="@id/bgIcon4"
                        app:layout_constraintStart_toStartOf="@id/bgIcon4"
                        app:layout_constraintTop_toTopOf="@id/bgIcon4" />

                    <TextView
                        android:id="@+id/tvLoc4Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/loc_4_title"
                        android:textColor="@color/text_primary_mapa"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/icChevron4"
                        app:layout_constraintStart_toEndOf="@id/bgIcon4"
                        app:layout_constraintTop_toTopOf="@id/bgIcon4" />

                    <TextView
                        android:id="@+id/tvLoc4Sub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/loc_4_sub"
                        android:textColor="@color/text_secondary_mapa"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/icChevron4"
                        app:layout_constraintStart_toEndOf="@id/bgIcon4"
                        app:layout_constraintTop_toBottomOf="@id/tvLoc4Title" />

                    <ImageView
                        android:id="@+id/icChevron4"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location Card 5: Vestiários -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLoc5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardLoc4"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <View
                        android:id="@+id/bgIcon5"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_blue_icon_sq"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_pin_location_blue"
                        app:layout_constraintBottom_toBottomOf="@id/bgIcon5"
                        app:layout_constraintEnd_toEndOf="@id/bgIcon5"
                        app:layout_constraintStart_toStartOf="@id/bgIcon5"
                        app:layout_constraintTop_toTopOf="@id/bgIcon5" />

                    <TextView
                        android:id="@+id/tvLoc5Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/loc_5_title"
                        android:textColor="@color/text_primary_mapa"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/icChevron5"
                        app:layout_constraintStart_toEndOf="@id/bgIcon5"
                        app:layout_constraintTop_toTopOf="@id/bgIcon5" />

                    <TextView
                        android:id="@+id/tvLoc5Sub"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/loc_5_sub"
                        android:textColor="@color/text_secondary_mapa"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/icChevron5"
                        app:layout_constraintStart_toEndOf="@id/bgIcon5"
                        app:layout_constraintTop_toBottomOf="@id/tvLoc5Title" />

                    <ImageView
                        android:id="@+id/icChevron5"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:baselineAligned="false"
        android:background="@color/card_bg"
        android:elevation="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout

            android:id="@+id/nav_inicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_home"
                android:textColor="@color/text_secondary_mapa"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout

            android:id="@+id/nav_treinos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
