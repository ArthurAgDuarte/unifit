<?xml version="1.0" encoding="utf-8"?>
<!-- Um dia na linha do tempo do Histórico Fitness: bolinha + linha + atividades do dia -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- Bolinha e linha vertical -->
    <LinearLayout
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:id="@+id/pontoDia"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_ponto_cinza" />

        <View
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@color/cinza_indicador" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtDiaHistorico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ontem • 15 set"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Atividades do dia (preenchidas no código) -->
        <LinearLayout
            android:id="@+id/layoutAtividadesDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

    </LinearLayout>

</LinearLayout>
