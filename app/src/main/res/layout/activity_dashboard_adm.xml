<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_app_adm"
    tools:context=".DashboardAdmActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:clipToPadding="false">

        <!-- Header -->
        <View
            android:id="@+id/vHeaderLogoBg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_logo"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/content_desc_logo"
            android:src="@drawable/ic_app_logo"
            app:layout_constraintBottom_toBottomOf="@id/vHeaderLogoBg"
            app:layout_constraintEnd_toEndOf="@id/vHeaderLogoBg"
            app:layout_constraintStart_toStartOf="@id/vHeaderLogoBg"
            app:layout_constraintTop_toTopOf="@id/vHeaderLogoBg" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/header_title_adm"
            android:textColor="@color/text_primary_adm"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/vHeaderLogoBg"
            app:layout_constraintEnd_toStartOf="@id/ivNotification"
            app:layout_constraintStart_toEndOf="@id/vHeaderLogoBg"
            app:layout_constraintTop_toTopOf="@id/vHeaderLogoBg" />

        <ImageView
            android:id="@+id/ivNotification"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/content_desc_notification"
            android:focusable="true"
            android:src="@drawable/ic_bell_adm"
            app:layout_constraintBottom_toBottomOf="@id/vHeaderLogoBg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/vHeaderLogoBg" />

        <!-- Greeting Section -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/greeting_default"
            android:textColor="@color/text_primary_adm"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vHeaderLogoBg" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle_today"
            android:textColor="@color/text_secondary_adm"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

        <!-- Stat Cards Row -->
        <HorizontalScrollView
            android:id="@+id/hsvStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Stat Card 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvStat1"
                    android:layout_width="120dp"
                    android:layout_height="140dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke_adm"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <View
                            android:id="@+id/vStat1IconBg"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_circle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_people"
                            app:layout_constraintBottom_toBottomOf="@id/vStat1IconBg"
                            app:layout_constraintEnd_toEndOf="@id/vStat1IconBg"
                            app:layout_constraintStart_toStartOf="@id/vStat1IconBg"
                            app:layout_constraintTop_toTopOf="@id/vStat1IconBg" />

                        <TextView
                            android:id="@+id/tvStat1Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/stat1_value"
                            android:textColor="@color/text_primary_adm"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/vStat1IconBg" />

                        <TextView
                            android:id="@+id/tvStat1Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stat1_label"
                            android:textColor="@color/text_secondary_adm"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvStat1Value" />

                        <TextView
                            android:id="@+id/tvStat1Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/stat1_badge"
                            android:textColor="@color/green_positive"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvStat1Label" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Stat Card 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvStat2"
                    android:layout_width="115dp"
                    android:layout_height="140dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke_adm"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <View
                            android:id="@+id/vStat2IconBg"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_circle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_calendar"
                            app:layout_constraintBottom_toBottomOf="@id/vStat2IconBg"
                            app:layout_constraintEnd_toEndOf="@id/vStat2IconBg"
                            app:layout_constraintStart_toStartOf="@id/vStat2IconBg"
                            app:layout_constraintTop_toTopOf="@id/vStat2IconBg" />

                        <TextView
                            android:id="@+id/tvStat2Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/stat2_value"
                            android:textColor="@color/text_primary_adm"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/vStat2IconBg" />

                        <TextView
                            android:id="@+id/tvStat2Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stat2_label"
                            android:textColor="@color/text_secondary_adm"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvStat2Value" />

                        <TextView
                            android:id="@+id/tvStat2Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/stat2_badge"
                            android:textColor="@color/amber_warning"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvStat2Label" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Stat Card 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvStat3"
                    android:layout_width="125dp"
                    android:layout_height="140dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_stroke_adm"
                    app:strokeWidth="1dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <View
                            android:id="@+id/vStat3IconBg"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_icon_circle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_dumbbell"
                            app:layout_constraintBottom_toBottomOf="@id/vStat3IconBg"
                            app:layout_constraintEnd_toEndOf="@id/vStat3IconBg"
                            app:layout_constraintStart_toStartOf="@id/vStat3IconBg"
                            app:layout_constraintTop_toTopOf="@id/vStat3IconBg" />

                        <TextView
                            android:id="@+id/tvStat3Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/stat3_value"
                            android:textColor="@color/text_primary_adm"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/vStat3IconBg" />

                        <TextView
                            android:id="@+id/tvStat3Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stat3_label"
                            android:textColor="@color/text_secondary_adm"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvStat3Value" />

                        <TextView
                            android:id="@+id/tvStat3Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/stat3_badge"
                            android:textColor="@color/red_alert"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvStat3Label" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Occupation Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvOccupation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke_adm"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hsvStats">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvOccupationTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/occupation_title"
                    android:textColor="@color/text_primary_adm"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvOccupationPercentage"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvOccupationPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/occupation_percentage"
                    android:textColor="@color/blue_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tvOccupationTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvOccupationTitle" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pbOccupation"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:progress="68"
                    app:trackCornerRadius="4dp"
                    app:indicatorColor="@color/blue_dark"
                    app:trackColor="@color/card_stroke_adm"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvOccupationTitle" />

                <TextView
                    android:id="@+id/tvOccupationSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/occupation_subtitle"
                    android:textColor="@color/text_secondary_adm"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/pbOccupation" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Search / Consult Form Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke_adm"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvOccupation">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvSearchCardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/search_card_title"
                    android:textColor="@color/text_primary_adm"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/email_hint_adm"
                    app:endIconMode="clear_text"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:errorEnabled="true"
                    app:startIconDrawable="@drawable/ic_email_adm"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSearchCardTitle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:importantForAutofill="yes"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearch"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="@color/blue_primary_adm"
                    android:text="@string/btn_search_adm"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilEmail" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Access Section -->
        <TextView
            android:id="@+id/tvQuickAccessTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/quick_access_title"
            android:textColor="@color/text_primary_adm"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvSearch" />

        <!-- Quick Access Item 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvQuick1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke_adm"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvQuickAccessTitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <View
                    android:id="@+id/vQuick1IconBg"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_square"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_people"
                    app:layout_constraintBottom_toBottomOf="@id/vQuick1IconBg"
                    app:layout_constraintEnd_toEndOf="@id/vQuick1IconBg"
                    app:layout_constraintStart_toStartOf="@id/vQuick1IconBg"
                    app:layout_constraintTop_toTopOf="@id/vQuick1IconBg" />

                <TextView
                    android:id="@+id/tvQuick1Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/quick1_title"
                    android:textColor="@color/text_primary_adm"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/ivQuick1Arrow"
                    app:layout_constraintStart_toEndOf="@id/vQuick1IconBg"
                    app:layout_constraintTop_toTopOf="@id/vQuick1IconBg" />

                <TextView
                    android:id="@+id/tvQuick1Subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/quick1_subtitle"
                    android:textColor="@color/text_secondary_adm"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="@id/tvQuick1Title"
                    app:layout_constraintStart_toStartOf="@id/tvQuick1Title"
                    app:layout_constraintTop_toBottomOf="@id/tvQuick1Title" />

                <ImageView
                    android:id="@+id/ivQuick1Arrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/content_desc_arrow"
                    android:src="@drawable/ic_chevron_right_adm"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Access Item 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvQuick2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke_adm"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvQuick1">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <View
                    android:id="@+id/vQuick2IconBg"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_square"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar"
                    app:layout_constraintBottom_toBottomOf="@id/vQuick2IconBg"
                    app:layout_constraintEnd_toEndOf="@id/vQuick2IconBg"
                    app:layout_constraintStart_toStartOf="@id/vQuick2IconBg"
                    app:layout_constraintTop_toTopOf="@id/vQuick2IconBg" />

                <TextView
                    android:id="@+id/tvQuick2Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/quick2_title"
                    android:textColor="@color/text_primary_adm"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/ivQuick2Arrow"
                    app:layout_constraintStart_toEndOf="@id/vQuick2IconBg"
                    app:layout_constraintTop_toTopOf="@id/vQuick2IconBg" />

                <TextView
                    android:id="@+id/tvQuick2Subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/quick2_subtitle"
                    android:textColor="@color/text_secondary_adm"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="@id/tvQuick2Title"
                    app:layout_constraintStart_toStartOf="@id/tvQuick2Title"
                    app:layout_constraintTop_toBottomOf="@id/tvQuick2Title" />

                <ImageView
                    android:id="@+id/ivQuick2Arrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/content_desc_arrow"
                    android:src="@drawable/ic_chevron_right_adm"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Access Item 3 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvQuick3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke_adm"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvQuick2">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <View
                    android:id="@+id/vQuick3IconBg"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_square"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_dumbbell"
                    app:layout_constraintBottom_toBottomOf="@id/vQuick3IconBg"
                    app:layout_constraintEnd_toEndOf="@id/vQuick3IconBg"
                    app:layout_constraintStart_toStartOf="@id/vQuick3IconBg"
                    app:layout_constraintTop_toTopOf="@id/vQuick3IconBg" />

                <TextView
                    android:id="@+id/tvQuick3Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/quick3_title"
                    android:textColor="@color/text_primary_adm"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/ivQuick3Arrow"
                    app:layout_constraintStart_toEndOf="@id/vQuick3IconBg"
                    app:layout_constraintTop_toTopOf="@id/vQuick3IconBg" />

                <TextView
                    android:id="@+id/tvQuick3Subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/quick3_subtitle"
                    android:textColor="@color/text_secondary_adm"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="@id/tvQuick3Title"
                    app:layout_constraintStart_toStartOf="@id/tvQuick3Title"
                    app:layout_constraintTop_toBottomOf="@id/tvQuick3Title" />

                <ImageView
                    android:id="@+id/ivQuick3Arrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/content_desc_arrow"
                    android:src="@drawable/ic_chevron_right_adm"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>