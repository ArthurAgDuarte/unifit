<?xml version="1.0" encoding="utf-8"?>
<!-- Card de uma notificação (estilo "não lida"; o código troca para cinza quando lida) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_branco"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imgNotificacao"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icone_notificacao"
        android:contentDescription="Ícone da notificação"
        android:padding="11dp"
        app:srcCompat="@drawable/ic_calendario_contorno"
        app:tint="@color/azul_unifit" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtTituloNotificacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Aula confirmada"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDetalheNotificacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Spinning hoje às 18:30 • há 10 min"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Bolinha azul de "não lida" -->
    <View
        android:id="@+id/pontoNaoLida"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_ponto_azul" />

</LinearLayout>
