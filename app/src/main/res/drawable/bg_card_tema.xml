<?xml version="1.0" encoding="utf-8"?>
<!-- Igual ao bg_card_branco, mas com as cores do tema (muda no alto contraste).
     Cópia porque bg_card_branco também é usado nas telas antigas, que têm cores fixas. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/corCard" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="?attr/corBorda" />
</shape>
